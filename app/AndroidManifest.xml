<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.loudbook.app"
    android:versionCode="1"
    android:versionName="0.1.0">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- voice commands: listened to on the phone only, while Loudbook is open or reading -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- to install its own updates from its GitHub releases -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
        android:extractNativeLibs="false"
        android:allowBackup="true"
        android:largeHeap="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Share a chapter link from Chrome: Share > Loudbook -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- "Open with Loudbook" for the supported fiction sites -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="www.royalroad.com" />
                <data android:host="royalroad.com" />
                <data android:host="archiveofourown.org" />
                <data android:host="www.fanfiction.net" />
                <data android:host="m.fanfiction.net" />
                <data android:host="www.fictionpress.com" />
                <data android:host="www.wattpad.com" />
                <data android:host="www.webnovel.com" />
                <data android:host="m.webnovel.com" />
                <data android:host="www.wuxiaworld.com" />
                <data android:host="www.scribblehub.com" />
                <data android:host="forums.spacebattles.com" />
                <data android:host="forums.sufficientvelocity.com" />
                <data android:host="forum.questionablequesting.com" />
            </intent-filter>
        </activity>

        <service
            android:name=".ReaderService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback|microphone" />

        <service
            android:name=".KindleService"
            android:label="@string/kindle_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/kindle_service" />
        </service>

        <receiver android:name=".Updater$Result" android:exported="false" />
        <receiver android:name=".Updater$Replaced" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
